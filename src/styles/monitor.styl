.monitor
    width: 80vmin;
    height: 60vmin;
    border: 12px solid #a67c52;
    border-radius: 16px;
    box-shadow: 0 0 20px #000, inset 0 0 10px #000;
    background-color: #111;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: all 0.3s ease;

.monitor-screen
    color: #3affff;
    font-size: 1.2rem;
    text-align: center;
    padding: 2rem;
    font-family: 'Courier New', monospace;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
