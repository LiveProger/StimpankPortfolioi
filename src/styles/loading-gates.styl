.loading-gates
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: space-between;
  z-index: 100;
  align-items: center;

.gate
  width: 50%;
  height: 100%;
  background-color: #2e2e2e;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: transform 1.2s ease-in-out;

.left-gate
  border-right: 2px solid #444;
  align-items: flex-end; /* Позиционируем шестерёнку справа */
  padding-right: 10px;

.right-gate
  border-left: 2px solid #444;
  align-items: flex-start; /* Позиционируем шестерёнку слева */
  padding-left: 10px;

.slide-left
  animation-name: var(--left-anim);
  animation-duration: 2.2s;
  animation-fill-mode: forwards;
  animation-timing-function: ease-in-out;

.slide-right
  animation-name: var(--right-anim);
  animation-duration: 2.2s;
  animation-fill-mode: forwards;
  animation-timing-function: ease-in-out;

.gear
  font-size: 3rem;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a67c52;

  &-container
    display: flex;
    position: relative;
    flex-direction: column;

    &-right
      top: 16px;

.large
  right: -28px;
  font-size: 4rem;
  margin-bottom: 10px;
  position: relative;
  transform: scale(1.2);
  animation: spinLarge 2s linear infinite;

.small
  left: -22px;
  font-size: 2rem;
  margin-bottom: 10px;
  position: relative;
  animation: spinSmall 1.2s linear infinite;

.label
  color: #f0c674;
  font-size: 1.2rem;
  letter-spacing: 2px;
  text-align: center;

@keyframes spinLarge
  from
    transform: rotate(0deg);

  to
    transform: rotate(360deg);

@keyframes spinSmall
  from
    transform: rotate(360deg);

  to
    transform: rotate(0deg);
