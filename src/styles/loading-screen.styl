.loading-screen
  position: relative
  width: 100%
  height: 100%
  overflow: hidden
  background-color: #1a1a1a
  display: flex
  align-items: center
  justify-content: center
  z-index: 10

  .gear
    font-size: 3rem
    animation: spin 2s linear infinite
    z-index: 12
    position: relative

  .gate-text
    position: absolute
    bottom: 2rem
    font-size: 1.2rem
    letter-spacing: 2px
    color: #f0c674
    z-index: 12

  .gate
    position: absolute
    top: 0
    width: 50%
    height: 100%
    background: #2d2d2d
    z-index: 11
    transition: transform 1.2s ease-in-out

  .left-gate
    left: 0
    border-right: 2px solid #444

  .right-gate
    right: 0
    border-left: 2px solid #444

  .slide-left
    transform: translateX(-100%)

  .slide-right
    transform: translateX(100%)

@keyframes spin
  0%
    transform: rotate(0deg)
  100%
    transform: rotate(360deg)
