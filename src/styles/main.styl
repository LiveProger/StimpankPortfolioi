@import './loading-gates.styl'

html, body, #root
  margin: 0
  padding: 0
  height: 100%
  width: 100%
  overflow: hidden

body
  font-family: 'Courier New', monospace
  background-color: #1a1a1a
  color: #f0c674

.app
  height: 100%
  width: 100%
  display: flex
  align-items: center
  justify-content: center

.main-view
  width: 100%
  height: 100%
  display: flex
  align-items: center
  justify-content: center
  background-color: #222
