@import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');

.keyboard
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    padding: 20px;
    background: linear-gradient(90deg, #2b2b2b, #252525);
    border: 4px solid #8b5e3c;
    border-radius: 15px;
    box-shadow: inset 0 0 10px #000, 0 0 20px rgba(0, 0, 0, 0.8);
    transform: perspective(800px) rotateX(25deg);
    transform-style: preserve-3d;
    transition: transform 0.3s ease;

.keyboard-top-padding
    position: relative;
    margin-top: 10px;
    width: 80%;
    height: 40px;
    background: radial-gradient(circle at center, #550000, #330000);
    border-radius: 20px;
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.6), inset 0 -2px 4px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    transform: perspective(800px) rotateX(15deg) translateZ(10px);

.key-row
    display: flex;
    justify-content: center;
    gap: 15px;

// Стилизация для кнопки
.key
    position: relative;
    overflow: hidden;
    width: 52px;
    height: 52px;
    margin: 6px;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, #3e3e3e, #1a1a1a);
    border: 2px solid #d4af37;
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.7), 0 2px 4px rgba(255, 255, 255, 0.1) inset, inset 0 -3px 6px rgba(0, 0, 0, 0.8);
    color: #f0e68c;
    font-family: 'Press Start 2P', cursive; // Используем стимпанковский шрифт
    font-size: 18px;
    text-align: center;
    line-height: 52px;
    cursor: pointer;
    transition: all 0.15s ease;
    z-index: 2;
    transform-style: preserve-3d; // Сохраняем 3D пространство для кнопки

    // Псевдоэлемент для глянцевого эффекта
    &::before
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0));
        transition: opacity 0.2s ease;
        pointer-events: none;
        transform: translateZ(1px); // Делаем глянец «выступающим»

    &:hover
        background: radial-gradient(circle at 30% 30%, #4e4e4e, #2a2a2a);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.85), 0 2px 6px rgba(255, 255, 255, 0.1) inset, inset 0 -4px 8px rgba(0, 0, 0, 0.8);

    &:active
        transform: translateY(3px) translateZ(2px); // Выдвигаем кнопку при нажатии, не забывая о 3D
        box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.9);
        // Подсветка при нажатии
        background: radial-gradient(circle at 30% 30%, #8c6e3d, #533a21); // Медный оттенок подсветки
        box-shadow: 0 0 15px 5px rgba(255, 140, 0, 0.8), 0 0 20px 10px rgba(0, 0, 0, 0.6) inset; // Подсветка с золотым и черным ободом
        z-index: 3;

// При нажатии кнопка опускается с добавлением теней и подсветки
.key.pressed
    transform: translateY(3px) translateZ(2px); // Продолжаем наклон
    background: radial-gradient(circle at 40% 40%, #292929, #111);
    box-shadow: inset 0 3px 6px rgba(0, 0, 0, 0.9);
    z-index: 1;
    // Подсветка при нажатии
    background: radial-gradient(circle at 30% 30%, #8c6e3d, #533a21); // Медный оттенок подсветки
    box-shadow: 0 0 15px 5px rgba(255, 140, 0, 0.8), 0 0 20px 10px rgba(0, 0, 0, 0.6) inset; // Золотисто-черная подсветка
    z-index: 3;

    &::before
        opacity: 0;

// Для кнопок, которые не нажаты, глянец виден
.key:not(.pressed)::before
    opacity: 1;


.key-ru
    font-size: 12px;

.key-en
    font-size: 18px;
    color: #f0e68c; // Блестящий желтый цвет для контраста

@media (max-width: 768px)
    .key
        width: 40px;
        height: 40px;
        font-size: 16px;
